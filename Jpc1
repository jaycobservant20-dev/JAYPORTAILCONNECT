    <!-- Script de logique -->
    <script>
        let toolAlreadyActivated = false;

        function switchPage(pageId) {
            document.getElementById('loginPage').classList.add('hidden');
            document.getElementById('activationPage').classList.add('hidden');
            document.getElementById('postActivationPage').classList.add('hidden');

            if (pageId === 'login') {
                document.getElementById('loginPage').classList.remove('hidden');
                document.getElementById('loginForm').reset();
                document.getElementById('loginError').classList.add('hidden');
            } else if (pageId === 'activation') {
                document.getElementById('activationPage').classList.remove('hidden');
                document.getElementById('activationForm').reset();
                document.getElementById('activationError').classList.add('hidden');
            } else if (pageId === 'postActivation') {
                document.getElementById('postActivationPage').classList.remove('hidden');
            }
        }

        function handleLogin(event) {
            event.preventDefault();
            const code = document.getElementById('loginSecurityCode').value.trim();
            const pass = document.getElementById('loginPassword').value.trim();

            if (code === "Ca6279" && pass === "Activation072026gsj") {
                switchPage('postActivation');
            } else {
                document.getElementById('loginError').classList.remove('hidden');
            }
        }

        function handleActivation(event) {
            event.preventDefault();

            const secCode = document.getElementById('actSecCode').value.trim();
            const pass = document.getElementById('actPass').value.trim();
            const profile = document.getElementById('actProfile').value.trim();
            const actCode = document.getElementById('actCodeAct').value.trim();
            const captcha = document.getElementById('actCaptcha').value.trim();

            if (
                secCode === "Ca6279" &&
                pass === "Activation072026gsj" &&
                profile === "Utilisateur64" &&
                actCode === "Activ1820292343" &&
                captcha === "Ja728najndm"
            ) {
                document.getElementById('activationError').classList.add('hidden');
                switchPage('postActivation');
            } else {
                document.getElementById('activationError').classList.remove('hidden');
            }
        }

        function openMailClient(event) {
            event.preventDefault();
            const subject = encodeURIComponent("Demande de code d'activation");
            const body = encodeURIComponent(
                "Salut,\n\nSi vous lisez ça, c'est que vous devez répondre à tous ces champs avant d'envoyer cet email.\n\n" +
                "Prénom :\n" +
                "Nom :\n" +
                "Âge :"
            );
            window.location.href = `mailto:support@jayconnectt.com?subject=${subject}&body=${body}`;
        }

        function activateTool() {
            const inputVal = document.getElementById('toolCodeInput').value.trim();
            const errorDiv = document.getElementById('toolError');
            const calcSection = document.getElementById('calculatorSection');

            if (toolAlreadyActivated) {
                errorDiv.textContent = "PAS BON OU OUTIL DÉJÀ ACTIVÉ / NON DISPONIBLE";
                errorDiv.classList.remove('hidden');
                return;
            }

            if (inputVal === "CALCUL64") {
                errorDiv.classList.add('hidden');
                calcSection.classList.remove('hidden');
                document.getElementById('toolCodeInput').disabled = true;
                toolAlreadyActivated = true;
            } else {
                errorDiv.textContent = "PAS BON OU OUTIL PAS DISPONIBLE";
                errorDiv.classList.remove('hidden');
            }
        }

        let calcDisplayValue = "0";

        function updateCalcScreen() {
            document.getElementById('calcScreen').textContent = calcDisplayValue;
        }

        function calcAppend(val) {
            if (calcDisplayValue === "0" && val !== '.') {
                calcDisplayValue = val;
            } else {
                calcDisplayValue += val;
            }
            updateCalcScreen();
        }

        function calcClear() {
            calcDisplayValue = "0";
            updateCalcScreen();
        }

        function calcBack() {
            if (calcDisplayValue.length > 1) {
                calcDisplayValue = calcDisplayValue.slice(0, -1);
            } else {
                calcDisplayValue = "0";
            }
            updateCalcScreen();
        }

        function calcCalculate() {
            try {
                let result = eval(calcDisplayValue.replace(/÷/g, '/').replace(/×/g, '*'));
                calcDisplayValue = String(result);
            } catch (error) {
                calcDisplayValue = "Erreur";
            }
            updateCalcScreen();
        }
    </script>
</body>
</html>
